# 复制此文件为 .env 后填入真实值
# 默认 LLM 配置（所有 Agent 共用）
LLM_BACKEND=openai

# 可选：只把 Researcher 明确标记的最多 4 个查询发送到 OpenAlex/Crossref。
# 默认关闭；只检索公开元数据和可用摘要，不下载全文。
RESEARCH_WEB_ENABLED=false
LLM_API_KEY=<your-api-key-here>
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=900
# 仅当供应商文档明确支持 Chat Completions 图像输入时才设为 true；默认不猜测能力。
LLM_SUPPORTS_IMAGES=false
# 可选：只给 Analyst 开启图像输入，优先于全局值。
# ANALYST_SUPPORTS_IMAGES=true

# 可选：使用本机已安装并登录的 Codex CLI
# 先运行 codex login 和 codex login status，再改为：
# LLM_BACKEND=codex
# Codex 模式不会读取上面的 API Key；API 配置会保留，切回 openai 后继续使用。

# ── 推荐配置（国奖竞争力关键）──────────────────────────
# 建模与验证是质量瓶颈，强烈推荐用推理模型：
# - 建模手需要多步数学推导（约束构造、变量耦合），reasoner 的链式推理
#   能显著减少模型漏洞和量纲错误
# - 验证者必须独立发现建模逻辑漏洞，与建模手同级或更强的推理能力
#   是「双重验证」有效的前提
MODELER_MODEL=deepseek-v4-pro
VERIFIER_MODEL=deepseek-v4-pro
# V4 Pro 同时支持思考与非思考模式，本模板统一使用 V4 Pro

# 每个 Agent 还可独立覆盖 API key 和 base_url（可选）
# MODELER_API_KEY=
# MODELER_BASE_URL=
# WRITER_MODEL=        # 预算允许时可换更强的中文写作模型

# 小米 MiMo 接入示例（OpenAI 兼容）：
# - Token Plan 订阅（tp- 开头的 key）：base_url 用 https://token-plan-cn.xiaomimimo.com/v1
# - 按量付费（sk- 开头的 key）：base_url 用 https://api.xiaomimimo.com/v1
# - 模型：mimo-v2.5-pro（推理强，1M 上下文）/ mimo-v2.5（支持图像输入）
# MODELER_API_KEY=tp-xxxxx
# MODELER_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MODELER_MODEL=mimo-v2.5-pro

# 输出 token 上限（默认 4096）。推理模型的思考过程也占输出额度，
# 必须调大，否则产出会被截断（实测 mimo-v2.5-pro 在 4096 下 model.md 为空）
# LLM_MAX_TOKENS=4096
# MODELER_MAX_TOKENS=32768
# VERIFIER_MAX_TOKENS=32768

# 工作空间
WORKSPACE_DIR=workspace
