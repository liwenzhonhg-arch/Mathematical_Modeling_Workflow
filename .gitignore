.env
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
test_cases/pytest_tmp*/
.mypy_cache/
.tmp/

# 竞赛工作空间（含数据和产出）
workspace/*/

# LaTeX 编译产物
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls
*.pdf
*.zip

# 真题实测成品快照可进 git
!test_cases/*/deliverables/paper.pdf
# 科研图表 benchmark 的受控 Matplotlib/MATLAB 矢量基准；其他 PDF 仍默认忽略
!test_cases/scientific_figure_benchmark/outputs/
!test_cases/scientific_figure_benchmark/outputs/matplotlib/
!test_cases/scientific_figure_benchmark/outputs/matplotlib/*.pdf
!test_cases/scientific_figure_benchmark/outputs/matlab/
!test_cases/scientific_figure_benchmark/outputs/matlab/*.pdf

# IDE
.vscode/
.idea/
.obsidian/
*.base
*.canvas

# Jupyter
.ipynb_checkpoints/
